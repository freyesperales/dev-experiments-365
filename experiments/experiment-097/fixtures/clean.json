{
  "jsonrpc": "2.0",
  "id": 1,
  "result": {
    "tools": [
      {
        "name": "get_weather",
        "title": "Weather 🏴󠁧󠁢󠁷󠁬󠁳󠁿",
        "description": "Get current weather information for a location. Data from https://api.weather.example/v1.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "location": {
              "type": "string",
              "description": "City name or zip code"
            }
          },
          "required": [
            "location"
          ]
        },
        "annotations": {
          "readOnlyHint": true
        }
      },
      {
        "name": "search_orders",
        "title": "Search orders",
        "description": "Search the shop's orders by customer email or order number. Returns at most 20 results. 👨‍💻",
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "Email or order number"
            },
            "limit": {
              "type": "integer",
              "description": "Max results (1-20)"
            }
          },
          "required": [
            "query"
          ]
        },
        "annotations": {
          "readOnlyHint": true
        }
      },
      {
        "name": "send_invoice",
        "description": "Email an invoice PDF to the customer on file for an order.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "order_id": {
              "type": "string"
            }
          },
          "required": [
            "order_id"
          ]
        },
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false
        }
      }
    ]
  }
}
