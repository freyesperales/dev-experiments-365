{
  "mcpServers": {
    "docs": { "command": "npx", "args": ["-y", "some-docs-mcp@1.4.2"] },
    "github": { "command": "npx", "args": ["-y", "@example/github-mcp@2.3.1"], "env": { "GITHUB_TOKEN": "${GITHUB_TOKEN}" } },
    "remote": { "url": "https://mcp.example.net/sse", "headers": { "Authorization": "Bearer ${MCP_TOKEN}" } }
  }
}
